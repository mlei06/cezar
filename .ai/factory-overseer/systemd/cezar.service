[Unit]
Description=Cezar cockpit for coding agents, the installed harness release (~/.cezar/versions/current) on 127.0.0.1:4321
After=network.target

[Service]
WorkingDirectory=%h
ExecStart=%h/.cezar/bin/cezar --no-open --port 4321 --bind-host 127.0.0.1
Environment=PATH=%h/.nvm/versions/node/v24.21.0/bin:%h/.local/bin:%h/.codex/bin:/usr/local/bin:/usr/bin:/bin
Environment=CEZ_AUTONOMOUS_DEFAULT=1
Environment=CEZ_SUPERVISED=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
